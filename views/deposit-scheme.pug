extends layout

block title
  | Deposit Scheme – NYONDO Hardware

block content
  .page-heading-center.mb-4
    h1
      i.fa-solid.fa-piggy-bank.me-2
      | Salary Earner Deposit Scheme
    p.text-muted Manage members, goals, deposits, and pickups

  .row.g-4.mb-4
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-users.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Active Members
        h3= activeMembers || 0
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-money-bill-wave.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Total Deposits
        h3= (totalDeposits || 0).toLocaleString() + ' UGX'
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-cart-shopping.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Total Pickups
        h3= (totalPickups || 0).toLocaleString() + ' UGX'
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-scale-balanced.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Current Balance
        h3= (currentBalance || 0).toLocaleString() + ' UGX'

  .d-flex.flex-wrap.gap-3.mb-4
    a.btn-primary(href="/deposit-scheme/members")
      i.fa-solid.fa-users.me-2
      | Members List
    a.btn-primary(href="/deposit-scheme/register")
      i.fa-solid.fa-user-plus.me-2
      | Register Member
    a.btn-primary(href="/deposit-scheme/transactions")
      i.fa-solid.fa-clock-rotate-left.me-2
      | View Transactions

  .row.g-4
    .col-md-6
      .section-card
        .section-head
          h2
            i.fa-solid.fa-arrow-up.me-2(style="color: var(--gold);")
            | Make Deposit
        .p-3
          form#depositForm(method="POST" action="/deposit-scheme/deposit" novalidate)
            .mb-3
              label.form-label Select Member
              select.form-select(name="memberId" id="depositMemberId" onchange="loadGoals(this)")
                option(value="") -- Select Member --
                each member in members
                  option(value=member._id.toString()) #{member.fullName} (#{member.phone})
              small.invalid-feedback Please select a member.
            .mb-3
              label.form-label Select Savings Goal
              select.form-select(name="goalId" id="goalSelect")
                option(value="") -- Select member first --
              small.invalid-feedback Please select a savings goal.
            .mb-3#goalInfo(style="display:none;")
              .section-card.p-3(style="background: rgba(0,51,0,0.04);")
                .d-flex.justify-content-between.mb-2
                  small.text-muted Product
                  strong#goalProduct —
                .d-flex.justify-content-between.mb-2
                  small.text-muted Target
                  strong#goalTarget —
                .d-flex.justify-content-between.mb-2
                  small.text-muted Saved
                  strong#goalSaved —
                .d-flex.justify-content-between.mb-2
                  small.text-muted Remaining
                  strong#goalRemaining —
                .progress.mt-2(style="height: 8px;")
                  .progress-bar#goalProgress(style="background: var(--dark-green); width: 0%;")
                .div.mt-2#goalReachedBadge(style="display:none;")
                  span.status-pill.sp-paid
                    i.fa-solid.fa-circle-check.me-1
                    | Goal Reached ✓
            .mb-3
              label.form-label Amount (UGX)
              input.form-control(type="number" name="amount" id="depositAmount" min="1000" step="1000" placeholder="Minimum 1,000 UGX")
              small.invalid-feedback Please enter a valid amount (minimum 1,000 UGX).
            .mb-3
              label.form-label Payment Method
              select.form-select(name="paymentMethod")
                option Cash
                option Mobile Money
                option Bank Transfer
            button.btn-primary.w-100(type="submit")
              i.fa-solid.fa-save.me-2
              | Record Deposit & Print Receipt

    .col-md-6
      .section-card
        .section-head
          h2
            i.fa-solid.fa-arrow-down.me-2(style="color: var(--gold);")
            | Pick Up Goods
        .p-3
          form#pickupForm(method="POST" action="/deposit-scheme/pickup" novalidate)
            .mb-3
              label.form-label Select Completed Goal
              select.form-select(name="memberId" id="pickupSelect")
                option(value="") -- Select completed goal --
                each member in members
                  each goal in member.goals
                    if goal.status === 'Goal Reached'
                      option(value=member._id.toString() data-goal=goal._id.toString()) #{member.fullName} — #{goal.productName} x#{goal.quantity}
              small.invalid-feedback Please select a completed goal.
            input(type="hidden" name="goalId" id="pickupGoalId")
            .mb-3
              .section-card.p-3(style="background: rgba(0,51,0,0.04);")
                p.mb-0.small.text-muted
                  i.fa-solid.fa-circle-check.text-success.me-2
                  | Only fully funded goals appear above. Stock was reserved at goal creation.
            button.btn-primary.w-100(type="submit")
              i.fa-solid.fa-box-open.me-2
              | Release Goods & Print Receipt

    .col-12
      .section-card
        .section-head
          h2
            i.fa-solid.fa-plus-circle.me-2(style="color: var(--gold);")
            | Add New Savings Goal to Existing Member
        .p-3
          form#addGoalForm(method="POST" action="/deposit-scheme/add-goal" novalidate)
            .row.g-3
              .col-md-3
                label.form-label Member *
                select.form-select(name="memberId" id="goalMemberId")
                  option(value="") -- Select Member --
                  each member in members
                    option(value=member._id) #{member.fullName}
                small.invalid-feedback Please select a member.
              .col-md-3
                label.form-label Product *
                select.form-select(name="productId" id="goalProductId" onchange="updateGoalTarget(this)")
                  option(value="") -- Select Product --
                  each prod in products
                    option(value=prod._id data-price=prod.unitPrice) #{prod.productName} — #{prod.unitPrice.toLocaleString()} UGX
                small.invalid-feedback Please select a product.
              .col-md-2
                label.form-label Quantity *
                input.form-control(type="number" name="quantity" id="goalQty" min="1" value="1" oninput="updateGoalTarget()")
                small.invalid-feedback Quantity must be at least 1.
              .col-md-2
                label.form-label Distance (km)
                input.form-control(type="number" name="distance" min="0" value="5" oninput="updateGoalTarget()")
              .col-md-2
                label.form-label Total Target
                input.form-control(type="text" id="newGoalTotal" readonly style="background:#f8f9fa; font-weight:700;")
              .col-md-3
                .form-check.mt-4
                  input#newGoalDelivery.form-check-input(type="checkbox" name="requiresDelivery" checked onchange="updateGoalTarget()")
                  label.form-check-label(for="newGoalDelivery") Requires Delivery
              .col-12
                button.btn-primary(type="submit")
                  i.fa-solid.fa-plus.me-2
                  | Add Goal

  .section-card.mt-4
    .section-head
      h2
        i.fa-solid.fa-bullseye.me-2(style="color: var(--gold);")
        | Members & Goals Overview
    .table-responsive
      table.data-table
        thead
          tr
            th Member
            th Product Goal
            th Qty
            th Saved (UGX)
            th Target (UGX)
            th Progress
            th Delivery
            th Status
        tbody
          each member in members
            each goal in member.goals
              tr
                td= member.fullName
                td= goal.productName
                td= goal.quantity
                td= goal.savedAmount.toLocaleString()
                td= goal.targetAmount.toLocaleString()
                td(style="min-width: 120px;")
                  - const pct = Math.min(Math.round((goal.savedAmount / goal.targetAmount) * 100), 100)
                  .progress(style="height:8px;")
                    .progress-bar(style=`background: var(--dark-green); width: ${pct}%;`)
                  small #{pct}%
                td
                  if goal.requiresDelivery
                    span.status-pill.sp-pending
                      i.fa-solid.fa-truck.me-1
                      | Yes (#{goal.deliveryFee.toLocaleString()} UGX)
                  else
                    span.text-muted No
                td
                  if goal.status === 'Goal Reached'
                    span.status-pill.sp-paid
                      i.fa-solid.fa-circle-check.me-1
                      | Goal Reached ✓
                  else if goal.status === 'Picked Up'
                    span.status-pill(style="background:rgba(59,130,246,0.1); color:#2563eb;")
                      i.fa-solid.fa-box-open.me-1
                      | Picked Up
                  else
                    span.status-pill.sp-pending Saving
            else
              tr
                td(colspan='8').text-center No members yet

  -
    var membersJson = JSON.stringify(members.map(function(m) {
      return {
        _id: m._id.toString(),
        goals: m.goals.map(function(g) {
          return {
            _id: g._id.toString(),
            productName: g.productName,
            quantity: g.quantity,
            targetAmount: g.targetAmount,
            savedAmount: g.savedAmount,
            status: g.status,
            deliveryFee: g.deliveryFee,
            requiresDelivery: g.requiresDelivery
          };
        })
      };
    }))

  script#members-data(type="application/json") !{membersJson}

  style.
    .form-control.is-invalid,
    .form-select.is-invalid {
      border-color: #dc3545 !important;
      box-shadow: 0 0 0 0.2rem rgba(220,53,69,.15) !important;
    }
    .invalid-feedback {
      display: none;
      color: #dc3545;
      font-size: 0.82rem;
      margin-top: 0.25rem;
    }
    .form-control.is-invalid ~ .invalid-feedback,
    .form-select.is-invalid ~ .invalid-feedback {
      display: block;
    }

  script.
    const membersData = JSON.parse(document.getElementById('members-data').textContent);

    // ── Validation helpers ─────────────────────────────────────────────────────
    function setInvalid(el) { el.classList.add('is-invalid'); el.classList.remove('is-valid'); }
    function setValid(el)   { el.classList.remove('is-invalid'); el.classList.add('is-valid'); }

    // ── Deposit form: load goals for selected member ───────────────────────────
    function loadGoals(select) {
      const memberId = select.value;
      const goalSelect = document.getElementById('goalSelect');
      const info = document.getElementById('goalInfo');
      goalSelect.innerHTML = '<option value="">-- Select Goal --</option>';
      info.style.display = 'none';
      if (!memberId) return;
      const member = membersData.find(m => m._id === memberId);
      if (!member) return;
      const active = member.goals.filter(g => g.status === 'Saving' || g.status === 'Goal Reached');
      if (active.length === 0) {
        goalSelect.innerHTML = '<option value="">-- No active goals --</option>';
        return;
      }
      active.forEach(g => {
        const opt = document.createElement('option');
        opt.value = g._id;
        opt.textContent = `${g.productName} x${g.quantity} — ${g.savedAmount.toLocaleString()} / ${g.targetAmount.toLocaleString()} UGX`;
        opt.setAttribute('data-goal', JSON.stringify(g));
        goalSelect.appendChild(opt);
      });
      goalSelect.onchange = function() {
        const selected = this.options[this.selectedIndex];
        const g = JSON.parse(selected.getAttribute('data-goal') || 'null');
        if (!g) { info.style.display = 'none'; return; }
        info.style.display = 'block';
        document.getElementById('goalProduct').textContent = `${g.productName} x${g.quantity}`;
        document.getElementById('goalTarget').textContent = g.targetAmount.toLocaleString() + ' UGX';
        document.getElementById('goalSaved').textContent = g.savedAmount.toLocaleString() + ' UGX';
        document.getElementById('goalRemaining').textContent = (g.targetAmount - g.savedAmount).toLocaleString() + ' UGX';
        const pct = Math.min(Math.round((g.savedAmount / g.targetAmount) * 100), 100);
        document.getElementById('goalProgress').style.width = pct + '%';
        document.getElementById('goalReachedBadge').style.display = g.status === 'Goal Reached' ? 'block' : 'none';
        setValid(this);
      };
      setValid(select);
    }

    // ── Pickup form: set hidden goalId ─────────────────────────────────────────
    document.getElementById('pickupSelect').addEventListener('change', function() {
      const selected = this.options[this.selectedIndex];
      document.getElementById('pickupGoalId').value = selected.getAttribute('data-goal') || '';
      this.value ? setValid(this) : setInvalid(this);
    });

    // ── Add goal form: calculate target ───────────────────────────────────────
    function updateGoalTarget() {
      const select = document.querySelector('select[name="productId"]');
      const selected = select.options[select.selectedIndex];
      const price = parseFloat(selected?.getAttribute('data-price')) || 0;
      const qty = parseInt(document.getElementById('goalQty').value) || 1;
      const distance = parseFloat(document.querySelector('input[name="distance"]').value) || 5;
      const needsDelivery = document.getElementById('newGoalDelivery').checked;
      const productTotal = price * qty;
      let delivery = 0;
      if (needsDelivery) {
        delivery = (productTotal >= 500000 && distance <= 10) ? 0 : 30000;
      }
      const total = productTotal + delivery;
      document.getElementById('newGoalTotal').value = total.toLocaleString() + ' UGX';
    }
    updateGoalTarget();

    // ── Live validation ────────────────────────────────────────────────────────
    document.getElementById('depositMemberId').addEventListener('change', function() {
      this.value ? setValid(this) : setInvalid(this);
    });
    document.getElementById('depositAmount').addEventListener('input', function() {
      parseFloat(this.value) >= 1000 ? setValid(this) : setInvalid(this);
    });
    document.getElementById('goalMemberId').addEventListener('change', function() {
      this.value ? setValid(this) : setInvalid(this);
    });
    document.getElementById('goalProductId').addEventListener('change', function() {
      this.value ? setValid(this) : setInvalid(this);
    });
    document.getElementById('goalQty').addEventListener('input', function() {
      parseInt(this.value) >= 1 ? setValid(this) : setInvalid(this);
    });

    // ── Deposit form submit ────────────────────────────────────────────────────
    document.getElementById('depositForm').addEventListener('submit', function(e) {
      let valid = true;
      const memberId = document.getElementById('depositMemberId');
      const goalSel  = document.getElementById('goalSelect');
      const amount   = document.getElementById('depositAmount');

      if (!memberId.value)                                        { setInvalid(memberId); valid = false; } else { setValid(memberId); }
      if (!goalSel.value)                                         { setInvalid(goalSel);  valid = false; } else { setValid(goalSel); }
      if (!amount.value || parseFloat(amount.value) < 1000)      { setInvalid(amount);   valid = false; } else { setValid(amount); }

      if (!valid) {
        e.preventDefault();
        const first = this.querySelector('.is-invalid');
        if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // ── Pickup form submit ─────────────────────────────────────────────────────
    document.getElementById('pickupForm').addEventListener('submit', function(e) {
      const pickupSel = document.getElementById('pickupSelect');
      if (!pickupSel.value) {
        setInvalid(pickupSel);
        e.preventDefault();
        pickupSel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        setValid(pickupSel);
      }
    });

    // ── Add goal form submit ───────────────────────────────────────────────────
    document.getElementById('addGoalForm').addEventListener('submit', function(e) {
      let valid = true;
      const goalMember  = document.getElementById('goalMemberId');
      const goalProduct = document.getElementById('goalProductId');
      const goalQty     = document.getElementById('goalQty');

      if (!goalMember.value)                              { setInvalid(goalMember);  valid = false; } else { setValid(goalMember); }
      if (!goalProduct.value)                             { setInvalid(goalProduct); valid = false; } else { setValid(goalProduct); }
      if (!goalQty.value || parseInt(goalQty.value) < 1) { setInvalid(goalQty);     valid = false; } else { setValid(goalQty); }

      if (!valid) {
        e.preventDefault();
        const first = this.querySelector('.is-invalid');
        if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
