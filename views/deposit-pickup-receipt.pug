doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Pickup Receipt | Nyondo Hardware
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
    style.
      :root { --dark-green: #003300; --gold: #f7b32b; }
      @media print { .no-print { display: none !important; } body { background: white; padding: 1rem; } .receipt-card { box-shadow: none; border: 1px solid #ddd; } }
      body { background: #f4f6f9; font-family: 'Segoe UI', sans-serif; padding: 2rem 1rem; }
      .receipt-card { max-width: 480px; margin: 0 auto; background: white; border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); overflow: hidden; }
      .receipt-header { background: var(--dark-green); color: white; padding: 1.5rem; text-align: center; }
      .receipt-header h1 { font-size: 1.4rem; font-weight: 700; margin: 0.5rem 0 0; }
      .receipt-header p { color: rgba(255,255,255,0.7); font-size: 0.85rem; margin: 0; }
      .brand-icon { font-size: 2.5rem; color: var(--gold); margin-bottom: 0.5rem; }
      .receipt-body { padding: 1.5rem; }
      .info-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f0f2f7; font-size: 0.88rem; }
      .info-row:last-child { border-bottom: none; }
      .info-row span:first-child { color: #6c757d; }
      .info-row strong { color: #1e2a2f; }
      .pickup-badge { background: #eff6ff; border: 1px solid #3b82f6; border-radius: 10px; padding: 12px; text-align: center; color: #1d4ed8; font-weight: 700; margin-top: 1rem; font-size: 1rem; }
      .footer-note { font-size: 0.72rem; color: #6c757d; text-align: center; margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed #dee2e6; }
      .divider { border-top: 1px dashed #dee2e6; margin: 1rem 0; }
  body
    .receipt-card
      .receipt-header
        .brand-icon
          i.fa-solid.fa-box-open
        h1 NYONDO HARDWARE
        p Goods Pickup Receipt

      .receipt-body
        .info-row
          span
            i.fa-solid.fa-user.me-1
            | Member
          strong= member.fullName
        .info-row
          span
            i.fa-solid.fa-phone.me-1
            | Phone
          strong= member.phone
        .info-row
          span
            i.fa-regular.fa-calendar.me-1
            | Date
          strong= new Date().toLocaleString()

        .divider

        .info-row
          span
            i.fa-solid.fa-box.me-1
            | Product
          strong= goal.productName
        .info-row
          span Quantity
          strong= goal.quantity + ' units'
        .info-row
          span Unit Price
          strong= goal.unitPrice.toLocaleString() + ' UGX'
        if goal.requiresDelivery
          .info-row
            span
              i.fa-solid.fa-truck.me-1
              | Delivery Fee
            strong= goal.deliveryFee.toLocaleString() + ' UGX'
        .info-row
          span Total Paid
          strong.text-success= goal.targetAmount.toLocaleString() + ' UGX'

        .pickup-badge
          i.fa-solid.fa-circle-check.me-2
          | ✅ Goods Released Successfully

        .footer-note
          p.mb-1
            i.fa-solid.fa-store.me-1
            | Nyondo Hardware — Nansana
          p.mb-0
            i.fa-solid.fa-print.me-1
            | Keep this receipt for your records. Thank you!

    .text-center.mt-3.no-print
      button.btn.btn-success.me-2(onclick="window.print()")
        i.fa-solid.fa-print.me-1
        | Print Receipt
      a.btn.btn-outline-secondary(href="/deposit-scheme")
        i.fa-solid.fa-arrow-left.me-1
        | Back to Deposit Scheme

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
