extends layout

block head
  link(rel="stylesheet" href="/css/record-payment.css")

block title
  | Record Payment – NYONDO Hardware

block content
  .page-heading-center.mb-4
    h1
      i.fa-solid.fa-money-bill-wave
      |  Record Supplier Payment
    p.text-muted Record payments against outstanding invoices

  if success_msg && success_msg.length
    .alert.alert-success= success_msg
  if error_msg && error_msg.length
    .alert.alert-danger= error_msg

  .form-card.payment-form-card

    //- Step 1: Supplier selector (GET — just reloads the page with supplier's invoices)
    form(method="GET" action="/payments/record")
      .mb-3
        label.form-label Select Supplier
        select.form-select(name='supplierId' onchange='this.form.submit()')
          option(value='') -- Choose Supplier --
          each sup in suppliers
            option(value=sup._id selected=(selectedSupplierId && selectedSupplierId.toString() === sup._id.toString()))= sup.companyName

    //- Step 2: Payment form — only shown when supplier with outstanding invoices is selected
    if selectedSupplier && outstandingInvoices && outstandingInvoices.length
      hr.my-4

      form#paymentForm(method="POST" action="/payments/record" novalidate)
        input(type="hidden" name="supplierId" value=selectedSupplier._id)

        .mb-3
          label.form-label Select Invoice *
          select.form-select(name='invoiceId' id='payInvoiceId')
            option(value='') -- Select Invoice --
            each inv in outstandingInvoices
              option(value=inv._id) #{inv.invoiceNumber} – #{inv.outstanding.toLocaleString()} UGX outstanding (Due: #{inv.dueDate ? new Date(inv.dueDate).toLocaleDateString() : '—'})
          small.invalid-feedback Please select an invoice.

        .mb-3
          label.form-label Payment Amount (UGX) *
          input.form-control(type='number' name='amount' id='payAmount' min='1' step='1000' placeholder='Enter amount to pay')
          small.invalid-feedback Please enter a valid payment amount (minimum 1 UGX).

        .mb-3
          label.form-label Payment Method *
          select.form-select(name='paymentMethod' id='payMethod')
            option(value='Cash') Cash
            option(value='Bank Transfer') Bank Transfer
            option(value='Mobile Money') Mobile Money
          small.invalid-feedback Please select a payment method.

        .mb-3
          label.form-label Payment Date
          input.form-control(type='date' name='paymentDate' value=today)

        .mb-3
          label.form-label Reference / Notes
          input.form-control(type='text' name='reference' placeholder='Optional reference or receipt number')

        button.btn-primary.w-100(type='submit')
          i.fa-solid.fa-check-circle.me-2
          | Record Payment

    else if selectedSupplier && (!outstandingInvoices || outstandingInvoices.length === 0)
      .alert.alert-info.mt-3
        i.fa-solid.fa-circle-info.me-2
        | No outstanding invoices for #{selectedSupplier.companyName}. All invoices are fully paid.

    else if !selectedSupplier
      .alert.alert-secondary.mt-3
        i.fa-solid.fa-arrow-up.me-2
        | Select a supplier above to see their outstanding invoices.

  style.
    .form-control.is-invalid,
    .form-select.is-invalid {
      border-color: #dc3545 !important;
      box-shadow: 0 0 0 0.2rem rgba(220,53,69,.15) !important;
    }
    .invalid-feedback {
      display: none;
      color: #dc3545;
      font-size: 0.82rem;
      margin-top: 0.25rem;
    }
    .form-control.is-invalid ~ .invalid-feedback,
    .form-select.is-invalid ~ .invalid-feedback {
      display: block;
    }

  if selectedSupplier && outstandingInvoices && outstandingInvoices.length
    script.
      function setInvalid(el) { el.classList.add('is-invalid'); el.classList.remove('is-valid'); }
      function setValid(el)   { el.classList.remove('is-invalid'); el.classList.add('is-valid'); }

      document.getElementById('payInvoiceId').addEventListener('change', function() {
        this.value ? setValid(this) : setInvalid(this);
      });
      document.getElementById('payAmount').addEventListener('input', function() {
        parseFloat(this.value) >= 1 ? setValid(this) : setInvalid(this);
      });
      document.getElementById('payMethod').addEventListener('change', function() {
        this.value ? setValid(this) : setInvalid(this);
      });

      document.getElementById('paymentForm').addEventListener('submit', function(e) {
        let valid = true;
        const invoice = document.getElementById('payInvoiceId');
        const amount  = document.getElementById('payAmount');
        const method  = document.getElementById('payMethod');

        if (!invoice.value)                             { setInvalid(invoice); valid = false; } else { setValid(invoice); }
        if (!amount.value || parseFloat(amount.value) < 1) { setInvalid(amount); valid = false; } else { setValid(amount); }
        if (!method.value)                              { setInvalid(method);  valid = false; } else { setValid(method); }

        if (!valid) {
          e.preventDefault();
          const first = this.querySelector('.is-invalid');
          if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
