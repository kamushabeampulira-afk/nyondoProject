extends layout

block title
  | Add New Product – NYONDO Hardware

block content
  .page-heading-center.mb-4
    h1
      i.fa-solid.fa-plus-circle
      |  Add New Product
    p.text-muted Register a new product and record the initial stock purchase

  .form-card
    form#addProductForm(method="POST" action="/inventory" novalidate)
      .row.g-3
        .col-md-6
          label.form-label Product Type *
          select.form-select(name='productType' id='productType')
            option(value='') -- Select Product --
            option(value='Cement (CEM II N)') Cement (CEM II N)
            option(value='Cement (CEM III N)') Cement (CEM III N)
            option(value='Iron Bar 10mm') Iron Bar 10mm
            option(value='Iron Bar 12mm') Iron Bar 12mm
            option(value='Iron Bar 16mm') Iron Bar 16mm
            option(value='Nails 1 inch (5kg)') Nails 1 inch (5kg)
            option(value='Nails 3 inch (5kg)') Nails 3 inch (5kg)
            option(value='Nails 4 inch (5kg)') Nails 4 inch (5kg)
            option(value='Nails 5 inch (5kg)') Nails 5 inch (5kg)
            option(value='Roofing Nails (5kg)') Roofing Nails (5kg)
            option(value='Wheelbarrow') Wheelbarrow
            option(value='Wire Mesh') Wire Mesh
            option(value='Barbed Wire (High Tensile)') Barbed Wire (High Tensile)
            option(value='Barbed Wire (Low Tensile)') Barbed Wire (Low Tensile)
            option(value='Iron Sheet (Blue)') Iron Sheet (Blue)
            option(value='Iron Sheet (Red)') Iron Sheet (Red)
            option(value='Iron Sheet (Green)') Iron Sheet (Green)
            option(value='Iron Sheet (White)') Iron Sheet (White)
            option(value='Iron Sheet (Brown)') Iron Sheet (Brown)
          small.invalid-feedback Please select a product type.
        .col-md-3
          label.form-label Unit Cost (UGX) *
          input.form-control(type='number' name='unitCost' id='prodUnitCost' step='500' placeholder='e.g. 35000')
          small.invalid-feedback Unit cost is required.
        .col-md-3
          label.form-label Unit Price (UGX) *
          input.form-control(type='number' name='unitPrice' id='prodUnitPrice' step='500' placeholder='e.g. 40000')
          small.invalid-feedback Unit price is required.
        .col-md-3
          label.form-label Initial Stock *
          input.form-control(type='number' name='currentStock' id='initialStock' min='0' placeholder='e.g. 100')
          small.invalid-feedback Initial stock is required (minimum 0).
        .col-md-6
          label.form-label Supplier Name *
          input.form-control(type='text' name='supplierName' id='prodSupplierName' placeholder='e.g. Tororo Cement Ltd')
          small.invalid-feedback Supplier name is required.
        .col-md-6
          label.form-label Supplier Phone
          input.form-control(type='tel' name='supplierPhone' placeholder='07XXXXXXXX')
        .col-md-6
          label.form-label Factory Name
          input.form-control(type='text' name='factoryName' placeholder='e.g. Tororo Factory')
        .col-md-6
          label.form-label Payment Status *
          select.form-select(name='paymentStatus' onchange='togglePaymentFields()')
            option(value='cash') Cash
            option(value='credit') Credit
        .col-md-6(id='amountPaidField')
          label.form-label Amount Paid (UGX)
          input.form-control(type='number' name='amountPaid' step='1000' value='0')
        .col-md-6(id='balanceDueField' style='display:none')
          label.form-label Balance Due (UGX)
          input.form-control(type='number' name='balanceDue' readonly class='bg-light')
      .d-flex.gap-3.mt-4
        button.btn-primary(type='submit')
          i.fa-solid.fa-save
          |  Save Product & Record Purchase
        a.btn-outline(href="/inventory") Cancel

  style.
    .form-control.is-invalid,
    .form-select.is-invalid {
      border-color: #dc3545 !important;
      box-shadow: 0 0 0 0.2rem rgba(220,53,69,.15) !important;
    }
    .invalid-feedback {
      display: none;
      color: #dc3545;
      font-size: 0.82rem;
      margin-top: 0.25rem;
    }
    .form-control.is-invalid ~ .invalid-feedback,
    .form-select.is-invalid ~ .invalid-feedback {
      display: block;
    }

  script.
    function togglePaymentFields() {
      const status      = document.querySelector('select[name="paymentStatus"]').value;
      const balanceField = document.getElementById('balanceDueField');
      if (status === 'credit') {
        balanceField.style.display = 'block';
      } else {
        balanceField.style.display = 'none';
        document.querySelector('input[name="amountPaid"]').value = '';
      }
    }

    function calculateTotalCost() {
      const qty  = parseFloat(document.querySelector('input[name="currentStock"]').value) || 0;
      const cost = parseFloat(document.querySelector('input[name="unitCost"]').value) || 0;
      return qty * cost;
    }

    document.querySelector('input[name="amountPaid"]').addEventListener('input', function() {
      const total  = calculateTotalCost();
      const paid   = parseFloat(this.value) || 0;
      const balanceInput = document.querySelector('input[name="balanceDue"]');
      if (balanceInput) balanceInput.value = Math.max(total - paid, 0);
    });

    document.querySelectorAll('input[name="currentStock"], input[name="unitCost"]').forEach(field => {
      field.addEventListener('input', function() {
        const amountPaid = document.querySelector('input[name="amountPaid"]');
        if (amountPaid && amountPaid.value) amountPaid.dispatchEvent(new Event('input'));
      });
    });

    togglePaymentFields();

    // ── Validation helpers ─────────────────────────────────────────────────────
    function setInvalid(el) { el.classList.add('is-invalid'); el.classList.remove('is-valid'); }
    function setValid(el)   { el.classList.remove('is-invalid'); el.classList.add('is-valid'); }

    // ── Live validation ────────────────────────────────────────────────────────
    document.getElementById('productType').addEventListener('change', function() {
      this.value ? setValid(this) : setInvalid(this);
    });
    document.getElementById('prodUnitCost').addEventListener('input', function() {
      parseFloat(this.value) > 0 ? setValid(this) : setInvalid(this);
    });
    document.getElementById('prodUnitPrice').addEventListener('input', function() {
      parseFloat(this.value) > 0 ? setValid(this) : setInvalid(this);
    });
    document.getElementById('initialStock').addEventListener('input', function() {
      this.value !== '' && parseFloat(this.value) >= 0 ? setValid(this) : setInvalid(this);
    });
    document.getElementById('prodSupplierName').addEventListener('input', function() {
      this.value.trim() ? setValid(this) : setInvalid(this);
    });

    // ── Submit validation ──────────────────────────────────────────────────────
    document.getElementById('addProductForm').addEventListener('submit', function(e) {
      let valid = true;

      const productType    = document.getElementById('productType');
      const unitCost       = document.getElementById('prodUnitCost');
      const unitPrice      = document.getElementById('prodUnitPrice');
      const initialStock   = document.getElementById('initialStock');
      const supplierName   = document.getElementById('prodSupplierName');

      if (!productType.value)                                  { setInvalid(productType);  valid = false; } else { setValid(productType); }
      if (!unitCost.value || parseFloat(unitCost.value) <= 0)  { setInvalid(unitCost);     valid = false; } else { setValid(unitCost); }
      if (!unitPrice.value || parseFloat(unitPrice.value) <= 0){ setInvalid(unitPrice);    valid = false; } else { setValid(unitPrice); }
      if (initialStock.value === '' || parseFloat(initialStock.value) < 0) { setInvalid(initialStock); valid = false; } else { setValid(initialStock); }
      if (!supplierName.value.trim())                          { setInvalid(supplierName); valid = false; } else { setValid(supplierName); }

      if (!valid) {
        e.preventDefault();
        const first = this.querySelector('.is-invalid');
        if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
