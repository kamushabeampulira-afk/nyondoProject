extends layout

block title
  | Supplier Credit – NYONDO Hardware

block content
  .page-heading-center.mb-4
    h1
      i.fa-solid.fa-credit-card
      |  Supplier Credit Management
    p.text-muted Track invoices, payments, and outstanding balances

  if success_msg && success_msg.length
    .alert.alert-success= success_msg
  if error_msg && error_msg.length
    .alert.alert-danger= error_msg

  .row.g-4.mb-4
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-file-invoice.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Total Credit
        h3= (totalCredit || 0).toLocaleString() + ' UGX'
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-clock.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Pending
        h3.text-warning= (pendingCredit || 0).toLocaleString() + ' UGX'
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-triangle-exclamation.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Overdue
        h3.text-danger= (overdueCredit || 0).toLocaleString() + ' UGX'
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-check-circle.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Paid This Month
        h3.text-success= (paidThisMonth || 0).toLocaleString() + ' UGX'

  .form-card.mb-4
    h4.mb-3
      i.fa-solid.fa-plus-circle.me-2(style="color: var(--gold);")
      | New Credit Purchase
    form#creditForm(method="POST" action="/supplier-credit/invoices" novalidate)
      .row.g-3
        .col-md-6
          label.form-label Supplier *
          select.form-select(name="supplierId" id="creditSupplierId")
            option(value="") -- Select Supplier --
            each sup in suppliers
              option(value=sup._id)= sup.companyName
          small.invalid-feedback Please select a supplier.
        .col-md-6
          label.form-label Invoice Number *
          input.form-control(type="text" name="invoiceNumber" id="invoiceNumber" placeholder="e.g. INV-001")
          small.invalid-feedback Invoice number is required.
        .col-md-4
          label.form-label Purchase Date *
          input.form-control(type="date" name="purchaseDate" id="purchaseDate" value=purchaseDateDefault)
          small.invalid-feedback Purchase date is required.
        .col-md-4
          label.form-label Due Date *
          input.form-control(type="date" name="dueDate" id="dueDate" value=dueDateDefault)
          small.invalid-feedback Due date is required and must be after the purchase date.
        .col-md-4
          label.form-label Total Amount (UGX) *
          input.form-control(type="number" name="totalAmount" id="totalAmount" min="0" step="1" placeholder="e.g. 500000")
          small.invalid-feedback Total amount is required.
        .col-12
          label.form-label Description
          textarea.form-control(rows="2" name="description" placeholder="What was purchased?")
        .col-md-6
          label.form-label Payment Terms
          select.form-select(name="paymentTerms")
            option Net 30
            option Net 15
            option Net 7
            option Due on receipt
        .col-md-6
          label.form-label Initial Payment (UGX)
          input.form-control(type="number" name="initialPayment" min="0" step="1" value="0")
      .mt-4
        button.btn-primary(type="submit")
          i.fa-solid.fa-save.me-2
          | Save Credit Purchase

  .section-card.mb-4
    .section-head
      h2
        i.fa-solid.fa-file-invoice.me-2(style="color: var(--gold);")
        | Outstanding Invoices
    .table-responsive
      table.data-table
        thead
          tr
            th Invoice #
            th Supplier
            th Total (UGX)
            th Paid (UGX)
            th Outstanding (UGX)
            th Due Date
            th Status
            th Pay
        tbody
          if invoices && invoices.length
            each inv in invoices
              - const isOverdue = inv.dueDate && new Date(inv.dueDate) < new Date() && inv.outstanding > 0
              - const daysRemaining = inv.dueDate ? Math.ceil((new Date(inv.dueDate) - new Date()) / (1000*3600*24)) : null
              tr
                td= inv.invoiceNumber
                td= inv.supplierId ? inv.supplierId.companyName : '—'
                td= inv.totalAmount.toLocaleString()
                td= inv.paidAmount.toLocaleString()
                td(class=inv.outstanding > 0 ? 'text-warning fw-bold' : 'text-success')= inv.outstanding.toLocaleString()
                td= inv.dueDate ? new Date(inv.dueDate).toLocaleDateString() : '—'
                td
                  if inv.status === 'Paid'
                    span.status-pill.sp-paid Paid ✓
                  else if isOverdue
                    span.status-pill.sp-credit Overdue
                  else if inv.status === 'Partially Paid'
                    span.status-pill.sp-scheme Partial
                  else
                    span.status-pill.sp-pending Pending
                td
                  if inv.outstanding > 0
                    form.inline-pay-form(method="POST" action=`/supplier-credit/pay/${inv._id}` novalidate)
                      .d-flex.gap-1
                        input.form-control.form-control-sm.pay-amount-input(
                          type="number"
                          name="amount"
                          placeholder="Amount"
                          min="1"
                          max=inv.outstanding
                          step="1"
                          style="width:130px;"
                        )
                        select.form-select.form-select-sm(name="paymentMethod" style="width:110px;")
                          option Cash
                          option Bank Transfer
                          option Mobile Money
                        button.btn-primary.btn-sm(type="submit")
                          i.fa-solid.fa-check
                  else
                    span.text-muted —
          else
            tr
              td(colspan="8").text-center No invoices found.

  .section-card
    .section-head
      h2
        i.fa-solid.fa-clock-rotate-left.me-2(style="color: var(--gold);")
        | Recent Payments
    .table-responsive
      table.data-table
        thead
          tr
            th Date
            th Supplier
            th Invoice #
            th Amount Paid (UGX)
            th Method
            th Reference
            th Receipt
        tbody
          if recentPayments && recentPayments.length
            each pmt in recentPayments
              tr
                td= pmt.paymentDate ? new Date(pmt.paymentDate).toLocaleDateString() : '—'
                td= pmt.supplierId ? pmt.supplierId.companyName : '—'
                td= pmt.invoiceId ? pmt.invoiceId.invoiceNumber : '—'
                td.text-success= pmt.amount.toLocaleString()
                td= pmt.paymentMethod || '—'
                td= pmt.reference || '—'
                td
                  a(
                    href=`/supplier-credit/receipt/${pmt._id}`
                    class="btn-outline btn-sm"
                    title="Download PDF Receipt"
                    target="_blank"
                  )
                    i.fa-solid.fa-file-pdf.me-1
                    | Receipt
          else
            tr
              td(colspan="7").text-center No recent payments.

  style.
    .form-control.is-invalid,
    .form-select.is-invalid {
      border-color: #dc3545 !important;
      box-shadow: 0 0 0 0.2rem rgba(220,53,69,.15) !important;
    }
    .invalid-feedback {
      display: none;
      color: #dc3545;
      font-size: 0.82rem;
      margin-top: 0.25rem;
    }
    .form-control.is-invalid ~ .invalid-feedback,
    .form-select.is-invalid ~ .invalid-feedback {
      display: block;
    }

  script.
    // ── Validation helpers ─────────────────────────────────────────────────────
    function setInvalid(el) { el.classList.add('is-invalid'); el.classList.remove('is-valid'); }
    function setValid(el)   { el.classList.remove('is-invalid'); el.classList.add('is-valid'); }

    // ── Live validation ────────────────────────────────────────────────────────
    document.getElementById('creditSupplierId').addEventListener('change', function() {
      this.value ? setValid(this) : setInvalid(this);
    });
    document.getElementById('invoiceNumber').addEventListener('input', function() {
      this.value.trim() ? setValid(this) : setInvalid(this);
    });
    document.getElementById('purchaseDate').addEventListener('change', function() {
      this.value ? setValid(this) : setInvalid(this);
    });
    document.getElementById('dueDate').addEventListener('change', function() {
      const purchase = document.getElementById('purchaseDate').value;
      if (this.value && (!purchase || this.value >= purchase)) { setValid(this); } else { setInvalid(this); }
    });
    document.getElementById('totalAmount').addEventListener('input', function() {
      parseFloat(this.value) > 0 ? setValid(this) : setInvalid(this);
    });

    // ── Main credit form submit ────────────────────────────────────────────────
    document.getElementById('creditForm').addEventListener('submit', function(e) {
      let valid = true;

      const supplierId    = document.getElementById('creditSupplierId');
      const invoiceNumber = document.getElementById('invoiceNumber');
      const purchaseDate  = document.getElementById('purchaseDate');
      const dueDate       = document.getElementById('dueDate');
      const totalAmount   = document.getElementById('totalAmount');

      if (!supplierId.value)                                    { setInvalid(supplierId);    valid = false; } else { setValid(supplierId); }
      if (!invoiceNumber.value.trim())                          { setInvalid(invoiceNumber); valid = false; } else { setValid(invoiceNumber); }
      if (!purchaseDate.value)                                  { setInvalid(purchaseDate);  valid = false; } else { setValid(purchaseDate); }
      if (!dueDate.value || (purchaseDate.value && dueDate.value < purchaseDate.value)) { setInvalid(dueDate); valid = false; } else { setValid(dueDate); }
      if (!totalAmount.value || parseFloat(totalAmount.value) <= 0) { setInvalid(totalAmount); valid = false; } else { setValid(totalAmount); }

      if (!valid) {
        e.preventDefault();
        const first = this.querySelector('.is-invalid');
        if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // ── Inline pay forms: validate amount before submit ────────────────────────
    document.querySelectorAll('.inline-pay-form').forEach(function(form) {
      form.addEventListener('submit', function(e) {
        const amountInput = this.querySelector('.pay-amount-input');
        const max = parseFloat(amountInput.getAttribute('max')) || Infinity;
        const val = parseFloat(amountInput.value);
        if (!amountInput.value || val < 1 || val > max) {
          setInvalid(amountInput);
          e.preventDefault();
          amountInput.focus();
        } else {
          setValid(amountInput);
        }
      });
      // Live clear on input
      const inp = form.querySelector('.pay-amount-input');
      inp.addEventListener('input', function() {
        const max = parseFloat(this.getAttribute('max')) || Infinity;
        const val = parseFloat(this.value);
        (val >= 1 && val <= max) ? setValid(this) : setInvalid(this);
      });
    });
