extends layout

block head
  link(rel="stylesheet" href="/css/suppliers.css")

block title
  | Suppliers – NYONDO Hardware

block content
  .page-heading-center.mb-4
    h1
      i.fa-solid.fa-truck-field
      |  Supplier Management
    p.text-muted Manage your hardware suppliers, track credit, and record purchases

  .row.g-4.mb-4
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-building.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Total Suppliers
        h3= totalSuppliers || 0
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-credit-card.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Total Credit Outstanding
        h3.text-warning= (totalOutstanding || 0).toLocaleString() + ' UGX'
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-clock.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Overdue Payments
        h3.text-danger= (overduePayments || 0).toLocaleString() + ' UGX'
    .col-md-3.col-sm-6
      .section-card.metric-card.p-3.text-center
        i.fa-solid.fa-truck-fast.fa-2x.mb-2(style="color: var(--gold);")
        h6.text-muted Active Orders
        h3= activeOrders || 0

  .supplier-form-container#supplierFormContainer
    .form-card
      .d-flex.justify-content-between.align-items-center.mb-3
        h4.mb-0
          i.fa-solid.fa-plus-circle.me-2(style="color: var(--gold);")
          | Add New Supplier
        button.btn-close(type='button' onclick='hideSupplierForm()')
      form#addSupplierForm(method="POST" action="/suppliers" novalidate)
        .row.g-3
          .col-md-6
            label.form-label Company Name *
            input.form-control(type='text' name='companyName' id='companyName' placeholder='e.g., Tororo Cement')
            small.invalid-feedback Company name is required.
          .col-md-6
            label.form-label Contact Person *
            input.form-control(type='text' name='contactPerson' id='contactPerson' placeholder='Full name')
            small.invalid-feedback Contact person name is required.
          .col-md-6
            label.form-label Phone Number *
            input.form-control(type='tel' name='phone' id='supplierPhone' placeholder='0772123456')
            small.invalid-feedback Enter a valid Ugandan phone number (07XXXXXXXX or +2567XXXXXXXX).
            small.text-muted Ugandan format: 07XXXXXXXX or +2567XXXXXXXX
          .col-md-6
            label.form-label Email
            input.form-control(type='email' name='email' id='supplierEmail' placeholder='supplier@example.com')
            small.invalid-feedback Please enter a valid email address.
          .col-12
            label.form-label Address
            textarea.form-control(rows='2' name='address' placeholder='Physical address')
          .col-md-6
            label.form-label Payment Status
            select.form-select(name='paymentStatus')
              option Fully Paid
              option Credit
          .col-md-6
            label.form-label Credit Limit (UGX)
            input.form-control(type='number' name='creditLimit' placeholder='0' min='0')
          .col-12
            label.form-label Products Supplied
            input.form-control(type='text' name='productsSupplied' placeholder='e.g., Cement, Iron Bars')
        .d-flex.gap-3.mt-4
          button.btn-primary(type='submit')
            i.fa-solid.fa-save
            |  Save Supplier
          button.btn-outline(type='button' onclick='hideSupplierForm()') Cancel

  .section-card
    .section-head
      h2
        i.fa-solid.fa-list.me-2(style="color: var(--gold);")
        | Supplier List
      .d-flex.gap-2.flex-wrap
        button#showSupplierFormBtn.btn-primary(onclick='showSupplierForm()')
          i.fa-solid.fa-plus
          |  Add Supplier
        a.btn-outline(href="/supplier-credit")
          i.fa-solid.fa-credit-card
          |  New Credit Purchase
    .table-responsive
      table.data-table
        thead
          tr
            th Company
            th Contact Person
            th Phone
            th Email
            th Outstanding (UGX)
            th Payment Terms
            th Actions
        tbody
          if suppliers && suppliers.length
            each sup in suppliers
              - const outstanding = sup.outstandingBalance || 0
              tr
                td
                  i.fa-solid.fa-building.me-2(style="color: var(--gold);")
                  = sup.companyName
                td= sup.contactPerson
                td= sup.phone
                td= sup.email || '—'
                td(class=outstanding > 0 ? 'text-warning' : '').amount= outstanding.toLocaleString()
                td= sup.paymentTerms || '—'
                td
                  a(href=`/suppliers/${sup._id}/edit`)
                    i.fa-regular.fa-pen-to-square.me-2(style='cursor:pointer;')
                  a(href=`/payments/record?supplierId=${sup._id}`)
                    i.fa-regular.fa-credit-card(style='cursor:pointer; color: var(--gold);')
          else
            tr
              td(colspan='7').text-center No suppliers found.
    .table-footer.p-3.border-top.d-flex.justify-content-between.flex-wrap.gap-2
      span.text-muted
        | Total Outstanding:
        strong.text-dark= ' ' + (totalOutstanding || 0).toLocaleString() + ' UGX'

  style.
    .form-control.is-invalid,
    .form-select.is-invalid {
      border-color: #dc3545 !important;
      box-shadow: 0 0 0 0.2rem rgba(220,53,69,.15) !important;
    }
    .invalid-feedback {
      display: none;
      color: #dc3545;
      font-size: 0.82rem;
      margin-top: 0.25rem;
    }
    .form-control.is-invalid ~ .invalid-feedback,
    .form-select.is-invalid ~ .invalid-feedback {
      display: block;
    }

  script.
    const formContainer = document.getElementById('supplierFormContainer');
    const showBtn = document.getElementById('showSupplierFormBtn');

    function showSupplierForm() {
      formContainer.classList.add('show');
      showBtn.style.display = 'none';
      formContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function hideSupplierForm() {
      formContainer.classList.remove('show');
      showBtn.style.display = 'inline-flex';
    }

    // ── Validation helpers ─────────────────────────────────────────────────────
    function setInvalid(el) { el.classList.add('is-invalid'); el.classList.remove('is-valid'); }
    function setValid(el)   { el.classList.remove('is-invalid'); el.classList.add('is-valid'); }

    const phoneRegex = /^(07|\+2567)\d{8}$/;
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    // ── Live validation ────────────────────────────────────────────────────────
    document.getElementById('companyName').addEventListener('input', function() {
      this.value.trim() ? setValid(this) : setInvalid(this);
    });
    document.getElementById('contactPerson').addEventListener('input', function() {
      this.value.trim() ? setValid(this) : setInvalid(this);
    });
    document.getElementById('supplierPhone').addEventListener('input', function() {
      phoneRegex.test(this.value.trim()) ? setValid(this) : setInvalid(this);
    });
    document.getElementById('supplierEmail').addEventListener('input', function() {
      // Email is optional — only validate format if something was typed
      if (!this.value.trim()) { this.classList.remove('is-invalid', 'is-valid'); return; }
      emailRegex.test(this.value.trim()) ? setValid(this) : setInvalid(this);
    });

    // ── Submit validation ──────────────────────────────────────────────────────
    document.getElementById('addSupplierForm').addEventListener('submit', function(e) {
      let valid = true;

      const companyName   = document.getElementById('companyName');
      const contactPerson = document.getElementById('contactPerson');
      const phone         = document.getElementById('supplierPhone');
      const email         = document.getElementById('supplierEmail');

      if (!companyName.value.trim())                  { setInvalid(companyName);   valid = false; } else { setValid(companyName); }
      if (!contactPerson.value.trim())                { setInvalid(contactPerson); valid = false; } else { setValid(contactPerson); }
      if (!phoneRegex.test(phone.value.trim()))       { setInvalid(phone);         valid = false; } else { setValid(phone); }
      if (email.value.trim() && !emailRegex.test(email.value.trim())) { setInvalid(email); valid = false; }

      if (!valid) {
        e.preventDefault();
        const first = this.querySelector('.is-invalid');
        if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
